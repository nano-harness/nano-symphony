{
  "name": "nano-symphony",
  "version": "0.9.6",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "cd frontend && bun run build",
    "lint": "tsc --noEmit",
    "test:unit": "bun test tests/unit tests/*.test.ts",
    "test:e2e": "bun test tests/e2e --concurrency 1",
    "test": "bun test tests/unit tests/*.test.ts && bun test tests/e2e --concurrency 1 && cd frontend && bun run test",
    "generate-contract": "bun scripts/generate-contract.ts",
    "workflow:validate": "bun scripts/validate-workflow.ts"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.0",
    "liquidjs": "^10.17.0",
    "nanoid": "^5.0.7",
    "pino": "^9.4.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.0"
  }
}
