{
  "name": "nano-symphony",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "cd frontend && npm run build",
    "lint": "tsc --noEmit",
    "test:unit": "bun test tests/unit tests/*.test.ts",
    "test:e2e": "bun test tests/e2e --concurrency 1",
    "test": "bun test tests/unit tests/*.test.ts && bun test tests/e2e --concurrency 1 && cd frontend && npm run test"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.0",
    "liquidjs": "^10.17.0",
    "nanoid": "^5.0.7",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.0"
  }
}
